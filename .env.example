# --- gateway ---
GATEWAY_HTTP_ADDR=:8080
GATEWAY_DATABASE_URL=postgres://auth:auth@postgres:5432/auth?sslmode=disable
GATEWAY_REDIS_ADDR=redis:6379
GATEWAY_REDIS_PASSWORD=change-me
GATEWAY_TOKENSVC_ADDR=tokensvc:9090
GATEWAY_COOKIE_SECURE=false

# --- tokensvc ---
TOKENSVC_GRPC_ADDR=:9090
TOKENSVC_DATABASE_URL=postgres://auth:auth@postgres:5432/auth?sslmode=disable
TOKENSVC_ACCESS_TTL=10m
TOKENSVC_REFRESH_TTL=720h

# --- github oauth ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback