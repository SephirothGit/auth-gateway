# --- postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
GATEWAY_DB_PASSWORD=change-me-gateway
TOKENSVC_DB_PASSWORD=change-me-tokensvc

# --- gateway ---
GATEWAY_HTTP_ADDR=:8080
GATEWAY_DATABASE_URL=postgres://gateway:change-me-gateway@postgres:5432/gateway?sslmode=disable
GATEWAY_REDIS_ADDR=redis:6379
GATEWAY_REDIS_PASSWORD=change-me-redis
GATEWAY_TOKENSVC_ADDR=tokensvc:9090
GATEWAY_COOKIE_SECURE=false
GATEWAY_GITHUB_CLIENT_ID=
GATEWAY_GITHUB_CLIENT_SECRET=
GATEWAY_GITHUB_REDIRECT_URL=http://localhost:8080/auth/github/callback

# --- tokensvc ---
TOKENSVC_GRPC_ADDR=:9090
TOKENSVC_DATABASE_URL=postgres://tokensvc:change-me-tokensvc@postgres:5432/tokensvc?sslmode=disable
TOKENSVC_SIGNING_KEY_PATH=/run/secrets/jwt_ed25519.pem